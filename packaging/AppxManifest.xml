<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="Churroser.WinMine"
    Publisher="CN=Churroser"
    Version="1.2.1.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Minesweeper</DisplayName>
    <PublisherDisplayName>Churroser</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>A WinUI 3 remake of the classic Minesweeper, with a Fluent Design UI and five UI languages.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="zh-CN" />
    <Resource Language="ja-JP" />
    <Resource Language="fr-FR" />
    <Resource Language="ko-KR" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="WinMine.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Minesweeper"
        Description="A WinUI 3 remake of the classic Minesweeper."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#1B1B1B" />
      </uap:VisualElements>
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="WinMine.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="WinMine.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
