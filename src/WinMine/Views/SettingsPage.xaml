<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinMine.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinMine.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Padding="20,0,20,24" MaxWidth="720" HorizontalAlignment="Left" Spacing="0">

            <TextBlock
                x:Name="PageTitle"
                Margin="2,8,0,6"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="设置" />

            <!--  外观  -->
            <TextBlock
                x:Name="AppearanceHeader"
                Style="{StaticResource SettingsSectionHeaderStyle}"
                Text="外观" />

            <controls:SettingsCard
                x:Name="ThemeCard"
                Description="跟随 Windows，或指定浅色 / 深色"
                Glyph="&#xE790;"
                Header="主题">
                <ComboBox
                    x:Name="ThemeCombo"
                    MinWidth="184"
                    DropDownClosed="Combo_DropDownClosed"
                    SelectionChanged="ThemeCombo_SelectionChanged" />
            </controls:SettingsCard>

            <!--  声音  -->
            <TextBlock
                x:Name="SoundHeader"
                Style="{StaticResource SettingsSectionHeaderStyle}"
                Text="声音" />

            <controls:SettingsCard
                x:Name="SoundCard"
                Description="翻开、插旗、爆炸与按钮点击音"
                Glyph="&#xE767;"
                Header="音效">
                <ToggleSwitch
                    x:Name="SoundToggle"
                    MinWidth="0"
                    OffContent=""
                    OnContent=""
                    Toggled="SoundToggle_Toggled" />
            </controls:SettingsCard>

            <!--  语言  -->
            <TextBlock
                x:Name="LanguageHeader"
                Style="{StaticResource SettingsSectionHeaderStyle}"
                Text="语言" />

            <controls:SettingsCard
                x:Name="LanguageCard"
                Description="界面文字；默认跟随 Windows 显示语言"
                Glyph="&#xE774;"
                Header="显示语言">
                <ComboBox
                    x:Name="LanguageCombo"
                    MinWidth="184"
                    DropDownClosed="Combo_DropDownClosed"
                    SelectionChanged="LanguageCombo_SelectionChanged" />
            </controls:SettingsCard>

            <!--  数据  -->
            <TextBlock
                x:Name="DataHeader"
                Style="{StaticResource SettingsSectionHeaderStyle}"
                Text="数据" />

            <controls:SettingsCard
                x:Name="ResetCard"
                Description="清除所有难度的最佳成绩"
                Glyph="&#xE74D;"
                Header="最佳成绩">
                <Button
                    x:Name="ResetButton"
                    MinWidth="96"
                    Click="ResetButton_Click"
                    Content="清除" />
            </controls:SettingsCard>

            <!--  关于  -->
            <TextBlock
                x:Name="AboutHeader"
                Style="{StaticResource SettingsSectionHeaderStyle}"
                Text="关于" />

            <controls:SettingsCard
                x:Name="AboutCard"
                Glyph="&#xE946;"
                Header="扫雷">
                <HyperlinkButton
                    x:Name="SourceLink"
                    Padding="8,2,8,2"
                    Click="SourceLink_Click"
                    Content="在 GitHub 上查看" />
            </controls:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
